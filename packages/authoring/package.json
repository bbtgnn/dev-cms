{
	"name": "@cms/authoring",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Authoring UI — shell, form shell, and chrome (ADR-0008 layer 1)",
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"svelte": "./dist/config/index.js",
			"default": "./dist/config/index.js"
		}
	},
	"dependencies": {
		"@cms/core": "workspace:*",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.48.0",
		"@sjsf/ajv8-validator": "catalog:",
		"@sjsf/form": "catalog:",
		"@sjsf/shadcn4-theme": "^3.8.1",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"cn": "^0.3.0",
		"shadcn-svelte": "^1.7.0",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^3.3.1",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/cli": "^4",
		"@tailwindcss/vite": "^4",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 4324",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4324",
		"prepare": "bun run build:package",
		"build:styles": "tailwindcss -i ./src/app.css -o ./src/lib/shadcn.css --minify",
		"build:package": "svelte-kit sync && bun run build:styles && svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun test ./src/lib/form ./src/lib/config ./src/lib/session/draft-eligibility.test.ts ./src/lib/session/authoring-props.test.ts",
		"check:layers": "bun run ./scripts/check-layer-boundaries.ts",
		"check:allowlist": "bun test ./src/lib/session/authoring-deletion.test.ts ./src/lib/session/authoring-assets.test.ts ./src/lib/session/autosave.test.ts ./src/lib/session/session.test.ts ./src/lib/session/open-authoring-session.test.ts",
		"pack:lib": "bun run ../../scripts/pack-lib.ts @cms/authoring",
		"test:config": "bun test ./src/lib/form/stock-registry.test.ts ./src/lib/config/create-field-control.test.ts"
	}
}
