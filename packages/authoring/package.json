{
	"name": "@cms/authoring",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Authoring UI — shell, form shell, and chrome (ADR-0008 layer 1)",
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config/index.ts"
	},
	"dependencies": {
		"@cms/core": "workspace:*",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.48.0",
		"@sjsf/ajv8-validator": "catalog:",
		"@sjsf/form": "catalog:",
		"@sjsf/shadcn4-theme": "^3.8.1",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"cn": "^0.3.0",
		"shadcn-svelte": "^1.7.0",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^3.3.1",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:"
	},
	"scripts": {
		"build:styles": "tailwindcss -i ./src/app.css -o ./src/shadcn.css --minify",
		"build:package": "bun run build:styles && svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json && bun test ./src/form ./src/config ./src/session/draft-eligibility.test.ts ./src/session/authoring-props.test.ts",
		"check:layers": "bun run ./scripts/check-layer-boundaries.ts",
		"check:allowlist": "bun test ./src/session/authoring-deletion.test.ts ./src/session/authoring-assets.test.ts ./src/session/autosave.test.ts ./src/session/session.test.ts ./src/session/open-authoring-session.test.ts",
		"pack:lib": "bun run ../../scripts/pack-lib.ts @cms/authoring",
		"test:config": "bun test ./src/form/stock-registry.test.ts ./src/config/create-field-control.test.ts"
	}
}
