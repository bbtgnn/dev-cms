{
	"name": "@cms/astro",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Astro host \u2014 cms() integration, /cms shell, /cms/api protocol transport",
	"files": [
		"dist"
	],
	"bin": {
		"cms": "./dist/cli.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./config": "./dist/host/config.js",
		"./collection-types": "./dist/collection-types.js",
		"./content-proxy": "./dist/content-proxy/index.js",
		"./testing": "./dist/testing.js",
		"./middleware-entry": "./dist/host/middleware-entry.js",
		"./protocol-route": "./dist/host/protocol-route.js",
		"./shell-page.astro": "./dist/host/shell-page.astro",
		"./cms-mount.svelte": "./dist/host/cms-mount.svelte"
	},
	"dependencies": {
		"@cms/authoring": "workspace:*",
		"@cms/core": "workspace:*",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"astro": "catalog:",
		"svelte": "catalog:"
	},
	"devDependencies": {
		"astro": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"zod": "catalog:"
	},
	"scripts": {
		"build": "tsdown",
		"watch": "tsdown --watch",
		"watch:assets": "bun ./scripts/copy-runtime-assets.ts --watch",
		"check": "bun ../../scripts/assert-package-face.ts @cms/astro && tsc -p . && svelte-check --tsconfig ./tsconfig.json && bun test src",
		"pack:lib": "bun run ../../scripts/pack-lib.ts @cms/astro",
		"test:content-proxy": "bun test ./src/content-proxy/content-proxy.test.ts",
		"test:stamped-host": "bun test ./src/stamped/stamped-host.test.ts",
		"test:happy-path": "bun test ./src/host/cms-happy-path.test.ts",
		"test:codegen": "bun test ./src/codegen/codegen-input-types.test.ts"
	}
}
