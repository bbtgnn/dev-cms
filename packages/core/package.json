{
	"name": "@cms/core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "CMS protocol + FS write-back adapters + schema\u2192form projection",
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/index.js",
		"./define-cms": "./dist/define-cms/define-cms.js",
		"./fetch-client": "./dist/protocol/fetch-client.js",
		"./form-tree": "./dist/form-tree/form-tree.js",
		"./http": "./dist/http/index.js",
		"./node": "./dist/node.js",
		"./protocol": "./dist/protocol/protocol.js",
		"./semantic": "./dist/semantic/index.js"
	},
	"dependencies": {
		"pathe": "^2.0.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:"
	},
	"scripts": {
		"build": "tsdown",
		"watch": "tsdown --watch",
		"check": "bun ../../scripts/assert-package-face.ts @cms/core && tsc -p . && bunx tsc -p ./scripts/tsconfig.fixtures.json",
		"check:allowlist": "bun test src",
		"pack:lib": "bun run ../../scripts/pack-lib.ts @cms/core",
		"test:semantic": "bun test ./src/semantic ./src/form-tree ./src/define-cms",
		"test:http": "bun test ./src/http"
	}
}
